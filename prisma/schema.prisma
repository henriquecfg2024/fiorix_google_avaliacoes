generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── ENUMS ─────────────────────────────────────────────────────────────

enum Role {
  MASTER
  ADMIN
  SUBSTITUTO
  USER
  RH
  COLABORADOR
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum Language {
  PT
  EN
  ES
}

enum ReviewStatus {
  PENDING
  RESPONDED
  IGNORED
}

enum SyncStatus {
  RUNNING
  COMPLETED
  FAILED
  TIMEOUT
}

// ── MULTI-TENANT ──────────────────────────────────────────────────────

model Tenant {
  id               String   @id @default(cuid())
  name             String
  slug             String?  @unique
  cnpj             String?  @unique
  dominio          String?  @unique
  cidade           String?
  estado           String?
  plano            String   @default("PRO")
  status           String   @default("ativo")
  maxUsuarios      Int      @default(100)
  dpoEmail         String?
  responsavelNome  String?
  responsavelEmail String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users             User[]
  colaboradores     Colaborador[]
  categories        Category[]
  templates         Template[]
  reviews           Review[]
  googleConnections GoogleConnection[]
  syncLogs          SyncLog[]
  biImports         FiorixBiImport[]
  biData            FiorixBiData[]
  metasImports      FiorixMetasImport[]
  metasDados        FiorixMetasDados[]
  retornosDados     FiorixRetornosDados[]
  impressoesDados   FiorixImpressoesDados[]
  intervencoes      FiorixIntervencao[]
  relatorios        FiorixRelatorio[]

  // Sincronização Automática - SaaS
  autoSyncEnabled Boolean                 @default(false)
  connectors      Connector[]
  syncBatches     ConnectorSyncBatch[]
  sourceStatuses  ConnectorSourceStatus[]
  syncRecords     ConnectorSyncRecord[]

  // FIORIX PESSOAS
  fiorixComunicados              FiorixComunicado[]
  fiorixComunicadoAnexos         FiorixComunicadoAnexo[]
  fiorixComunicadoCiencias       FiorixComunicadoCiencia[]
  fiorixHolerites                FiorixHolerite[]
  fiorixFeriasPrevistas          FiorixFeriasPrevista[]
  fiorixFeriasPrevistaHistoricos FiorixFeriasPrevistaHistorico[]
  fiorixFeriasAvisos             FiorixFeriasAviso[]
  fiorixAcessoLogs               FiorixAcessoLog[]

  // MENSAGENS CORPORATIVAS
  conversas          Conversa[]
  conversaMembros    ConversaMembro[]
  mensagens          Mensagem[]
  mensagemAnexos     MensagemAnexo[]
  mensagemReacoes    MensagemReacao[]
  pushSubscriptions  PushSubscription[]
  messagingSettings  MessagingNotificationSettings[]
  messagingPolicy    MessagingPolicy?
  messagingAuditLogs MessagingAuditLog[]
}

// ── USERS ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cpf          String?  // CPF do colaborador (11 dígitos, sem formatação)
  departamento String?
  cargo        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, cpf])

  // FIORIX PESSOAS
  comunicadosCriados       FiorixComunicado[]              @relation("ComunicadosCriados")
  comunicadoAnexos         FiorixComunicadoAnexo[]
  comunicadoCiencias       FiorixComunicadoCiencia[]
  holerites                FiorixHolerite[]
  holeritesUploaded        FiorixHolerite[]                @relation("HoleritesUploaded")
  feriasPrevistas          FiorixFeriasPrevista[]
  feriasPrevistasUpdated   FiorixFeriasPrevista[]          @relation("FeriasPrevistasUpdated")
  feriasPrevistaHistoricos FiorixFeriasPrevistaHistorico[]
  feriasHistoricoAlterador FiorixFeriasPrevistaHistorico[] @relation("FeriasHistoricoAlterador")
  feriasAvisos             FiorixFeriasAviso[]
  feriasAvisoUploaded      FiorixFeriasAviso[]             @relation("FeriasAvisoUploaded")
  acessoLogs               FiorixAcessoLog[]
  acessoLogsAlvo           FiorixAcessoLog[]               @relation("AcessoLogAlvo")

  // Google Authenticator 2FA (TOTP) — somente ADMIN/MASTER
  totpSecret     String? // Segredo TOTP criptografado (base32)
  totpEnabled    Boolean   @default(false)
  totpVerifiedAt DateTime? // Data em que ativou 2FA

  // MENSAGENS CORPORATIVAS
  conversasCriadas   Conversa[]                     @relation("ConversasCriadas")
  conversaMembros    ConversaMembro[]
  mensagensEnviadas  Mensagem[]                     @relation("MensagensEnviadas")
  mensagensReacoes   MensagemReacao[]
  pushSubscriptions  PushSubscription[]
  messagingSettings  MessagingNotificationSettings?
  messagingAuditLogs MessagingAuditLog[]
}

// ── CARTÓRIO DATA (DYNAMIC) ───────────────────────────────────────────

model Colaborador {
  id        String   @id @default(cuid())
  name      String
  aliases   String[] // Aliases for fuzzy matching (e.g. ["Fernandinho"])
  active    Boolean  @default(true)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentions ReviewMention[]
}

model Category {
  id        String   @id @default(cuid())
  name      String // e.g. "Fila / Espera", "Site", "Atendimento"
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentions ReviewMention[]
}

model Template {
  id        String   @id @default(cuid())
  name      String
  content   String // The text of the template with placeholders
  language  Language @default(PT)
  minRating Int      @default(1) // Can configure template for specific ratings (e.g. 5 only)
  maxRating Int      @default(5)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── REVIEWS & AI DATA ─────────────────────────────────────────────────

model Review {
  id           String       @id @default(cuid())
  googleId     String?      @unique
  reviewerName String
  rating       Int
  comment      String?
  language     Language     @default(PT)
  publishedAt  DateTime
  status       ReviewStatus @default(PENDING)

  // AI Extracted Data
  aiSummary   String?
  aiSentiment Sentiment?

  // Soft-delete: marcado como true quando a avaliação não existe mais no Google
  deletedFromGoogle Boolean @default(false)

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentions ReviewMention[]
  response Response?

  @@index([tenantId, status, deletedFromGoogle], name: "idx_review_tenant_status_deleted")
}

model ReviewMention {
  id       String @id @default(cuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  colaboradorId String?
  colaborador   Colaborador? @relation(fields: [colaboradorId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  sentiment Sentiment // Sentiment specific to this mention (e.g. they praised the Escrevente but complained about Category)

  createdAt DateTime @default(now())
}

model Response {
  id       String @id @default(cuid())
  reviewId String @unique
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  content   String
  isAiDraft Boolean   @default(false)
  sentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── GOOGLE API ────────────────────────────────────────────────────────

model GoogleConnection {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  accountId    String // Google Business Account ID
  locationId   String // Specific Location ID
  accessToken  String
  refreshToken String
  expiresAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId], name: "idx_google_connection_tenant_id")
}

model SyncLog {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status          SyncStatus @default(RUNNING)
  trigger         String     @default("MANUAL")
  triggeredBy     String?
  startedAt       DateTime   @default(now())
  finishedAt      DateTime?
  durationMs      Int?
  reviewsFetched  Int        @default(0)
  reviewsImported Int        @default(0)
  errorMessage    String?
  createdAt       DateTime   @default(now())

  @@index([tenantId, createdAt(sort: Desc)], name: "idx_sync_log_tenant_created")
}

// ── FIORIX BI MODULE ──────────────────────────────────────────────────

model FiorixBiImport {
  id           String   @id @default(uuid())
  tenantId     String   @default("") @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileName     String   @map("file_name")
  importedAt   DateTime @default(now()) @map("imported_at")
  rowsCount    Int      @map("rows_count")
  importedBy   String?  @default("Manual SSMS") @map("imported_by")
  status       String   @default("SUCCESS")
  errorMessage String?  @map("error_message")

  data FiorixBiData[]

  @@index([tenantId], name: "idx_fiorix_bi_imports_tenant_id")
  @@map("fiorix_bi_imports")
}

model FiorixBiData {
  id       String         @id @default(uuid())
  tenantId String         @default("") @map("tenant_id")
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importId String         @map("import_id")
  import   FiorixBiImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  protocolo          String    @map("Protocolo")
  flagRecepcao       Int?      @map("FlagRecepcao")
  tipoSolicitacao    String?   @map("TipoSolicitacao")
  idAndamento        BigInt?   @map("IdAndamento")
  dtProtocolo        DateTime? @map("DtProtocolo")
  dtPrevisaoEntrega  DateTime? @map("DtPrevisaoEntrega")
  dtAndamento        DateTime? @map("DtAndamento")
  codProcessamento   Int?      @map("CodProcessamento")
  descAndamento      String?   @map("DescAndamento")
  natureza           String?   @map("Natureza")
  tipoPrenotacao     String?   @map("TipoPrenotacao")
  diasPrometidos     Int?      @map("DiasPrometidos")
  diasCorridos       Int?      @map("DiasCorridos")
  diasAtraso         Int?      @map("DiasAtraso")
  situacaoPrazo      String?   @map("SituacaoPrazo")
  isDevolucao        Boolean?  @default(false) @map("IsDevolucao")
  isRegistrado       Boolean?  @default(false) @map("IsRegistrado")
  textoNotaDevolucao String?   @map("TextoNotaDevolucao")

  @@unique([importId, idAndamento], name: "fiorix_bi_data_import_id_andamento_key")
  @@index([tenantId], name: "idx_fiorix_bi_data_tenant_id")
  @@index([importId], name: "idx_fiorix_bi_data_import_id")
  @@index([dtAndamento], name: "idx_fiorix_bi_data_dt_andamento")
  @@index([codProcessamento], name: "idx_fiorix_bi_data_cod_proc")
  @@index([tipoPrenotacao], name: "idx_fiorix_bi_data_tipo_prenotacao")
  @@map("fiorix_bi_data")
}

// ── FIORIX METAS MODULE ───────────────────────────────────────────────

model FiorixMetasImport {
  id           Int       @id @default(autoincrement())
  tenantId     String    @default("") @map("tenant_id")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importKey    String?   @map("import_key") @db.VarChar(100)
  arquivo      String?   @db.VarChar(255)
  periodo      String?   @db.VarChar(100)
  dataHora     DateTime? @default(now()) @map("data_hora")
  linhas       Int?
  inseridas    Int?
  importadoPor String?   @map("importado_por") @db.VarChar(100)
  status       String?   @db.VarChar(20)

  dados FiorixMetasDados[]

  @@unique([tenantId, importKey], name: "fiorix_metas_imports_tenant_import_key")
  @@index([tenantId], name: "idx_fiorix_metas_imports_tenant_id")
  @@map("fiorix_metas_imports")
}

model FiorixMetasDados {
  protocolo         Int       @id @map("protocolo")
  tenantId          String    @default("") @map("tenant_id")
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dataApresentado   DateTime? @map("data_apresentado")
  dtPrevisao        DateTime? @map("dt_previsao")
  dtEntregaReal     DateTime? @map("dt_entrega_real")
  status            String?   @db.VarChar(50)
  natureza          String?   @db.VarChar(255)
  atrasoDias        Int?      @map("atraso_dias")
  d1Protocolo       DateTime? @map("d1_protocolo")
  d1Escaneamento    DateTime? @map("d1_escaneamento")
  d2Contraditorio   DateTime? @map("d2_contraditorio")
  d3Extrato         DateTime? @map("d3_extrato")
  d4Qualificacao    DateTime? @map("d4_qualificacao")
  d5Calculo         DateTime? @map("d5_calculo")
  d8Impressao       DateTime? @map("d8_impressao")
  d9Preparacao      DateTime? @map("d9_preparacao")
  d9Conferencia     DateTime? @map("d9_conferencia")
  d10Entrega        DateTime? @map("d10_entrega")
  dBalcaoRegistrado DateTime? @map("d_balcao_registrado")
  dBalcaoDevolvido  DateTime? @map("d_balcao_devolvido")
  qtdRetrabalho     Int?      @map("qtd_retrabalho")
  diasD1D2          Int?      @map("dias_d1_d2")
  diasD2D3          Int?      @map("dias_d2_d3")
  diasD3D4          Int?      @map("dias_d3_d4")
  diasD4D5          Int?      @map("dias_d4_d5")
  diasD5D8          Int?      @map("dias_d5_d8")
  diasD8D9          Int?      @map("dias_d8_d9")

  importId Int?               @map("import_id")
  import   FiorixMetasImport? @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([tenantId], name: "idx_fiorix_metas_dados_tenant_id")
  @@index([importId], name: "idx_fiorix_metas_dados_import_id")
  @@map("fiorix_metas_dados")
}

model FiorixRetornosDados {
  tenantId               String    @map("tenant_id")
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  idAndamento            BigInt    @map("id_andamento")
  idRecepcao             Int?      @map("id_recepcao")
  numeroPrenotacao       Int       @map("numero_prenotacao")
  dataRecepcao           DateTime? @map("data_recepcao")
  tipoRecepcao           String?   @map("tipo_recepcao") @db.VarChar(50)
  formaTitulo            String?   @map("forma_titulo") @db.VarChar(255)
  idTipoRetorno          Int       @map("id_tipo_retorno")
  siglaRetorno           String?   @map("sigla_retorno") @db.VarChar(20)
  tipoRetorno            String?   @map("tipo_retorno") @db.VarChar(100)
  familiaRetorno         String?   @map("familia_retorno") @db.VarChar(50)
  classificacao          String?   @map("classificacao") @db.VarChar(50)
  dataRetorno            DateTime  @map("data_retorno")
  idUsuarioOrigem        String?   @map("id_usuario_origem") @db.VarChar(50)
  usuarioOrigem          String?   @map("usuario_origem") @db.VarChar(255)
  idUsuarioDestino       String?   @map("id_usuario_destino") @db.VarChar(50)
  usuarioDestinoRetorno  String?   @map("usuario_destino_retorno") @db.VarChar(255)
  observacao             String?   @map("observacao") @db.Text
  seqTitulo              Int?      @map("seq_titulo")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@id([tenantId, idAndamento])
  @@index([tenantId, dataRetorno(sort: Desc)], name: "idx_fiorix_retornos_tenant_data")
  @@index([tenantId, idUsuarioDestino], name: "idx_fiorix_retornos_tenant_usuario_destino")
  @@index([tenantId, idTipoRetorno], name: "idx_fiorix_retornos_tenant_tipo")
  @@index([tenantId, numeroPrenotacao], name: "idx_fiorix_retornos_tenant_prenotacao")
  @@map("fiorix_retornos_dados")
}

model FiorixImpressoesDados {
  tenantId               String    @map("tenant_id")
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  idAndamento            BigInt    @map("id_andamento")
  idRecepcao             Int?      @map("id_recepcao")
  numeroPrenotacao       Int       @map("numero_prenotacao")
  seqTitulo              Int?      @default(1) @map("seq_titulo")
  dataEntrada            DateTime? @map("data_entrada")
  tipoPrenotacao         String?   @map("tipo_prenotacao") @db.VarChar(50)
  natureza               String?   @map("natureza") @db.VarChar(255)
  numeroLivro            String?   @map("numero_livro") @db.VarChar(100)
  idTipoAndamento        Int       @map("id_tipo_andamento")
  siglaAndamento         String?   @map("sigla_andamento") @db.VarChar(20)
  tipoAndamento          String?   @map("tipo_andamento") @db.VarChar(100)
  tipoImpressao          String    @map("tipo_impressao") @db.VarChar(50) // 'LIVRO' | 'CERTIDAO'
  dataImpressao          DateTime  @map("data_impressao")
  idOperador             String?   @map("id_operador") @db.VarChar(50)
  operador               String?   @map("operador") @db.VarChar(255)
  idUsuarioDestino       String?   @map("id_usuario_destino") @db.VarChar(50)
  usuarioDestino         String?   @map("usuario_destino") @db.VarChar(255)
  observacao             String?   @map("observacao") @db.Text
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@id([tenantId, idAndamento])
  @@index([tenantId, dataImpressao(sort: Desc)], name: "idx_fiorix_impressoes_tenant_data")
  @@index([tenantId, tipoImpressao], name: "idx_fiorix_impressoes_tenant_tipo")
  @@index([tenantId, numeroPrenotacao], name: "idx_fiorix_impressoes_tenant_prenotacao")
  @@index([tenantId, operador], name: "idx_fiorix_impressoes_tenant_operador")
  @@map("fiorix_impressoes_dados")
}

model RateLimit {
  key       String   @id
  points    Int      @default(0)
  expireAt  DateTime
  updatedAt DateTime @updatedAt

  @@map("fiorix_rate_limits")
}

model FiorixIntervencao {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  data      DateTime @default(now())
  protocolo Int
  tipo      String   @db.VarChar(100)
  de        String   @db.VarChar(100)
  para      String   @db.VarChar(100)
  motivo    String   @db.Text
  risco     String   @db.VarChar(50)
  usuario   String   @db.VarChar(100)
  aprovado  String   @db.VarChar(100)

  @@index([tenantId])
  @@index([tenantId, data])
  @@map("fiorix_intervencoes")
}

model FiorixRelatorio {
  id       String   @id @default(cuid())
  tenantId String   @map("tenant_id")
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  data     DateTime @default(now())
  arquivo  String   @db.VarChar(255)
  setor    String   @db.VarChar(100)
  status   String   @db.VarChar(50)
  url      String?  @db.Text

  @@index([tenantId])
  @@index([tenantId, data])
  @@map("fiorix_relatorios")
}

// ── CONNECTOR & SYNC INFRASTRUCTURE ───────────────────────────────────

model Connector {
  id                   String    @id @default(cuid())
  tenantId             String
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  status               String    @default("offline") // offline, online
  version              String?
  enabled              Boolean   @default(true)
  credentialIdentifier String // Hash bcrypt da credencial
  lastSeenAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  batches        ConnectorSyncBatch[]
  sourceStatuses ConnectorSourceStatus[]
  staging        ConnectorSyncStaging[]
  syncRecords    ConnectorSyncRecord[]

  @@index([tenantId])
}

model ConnectorSyncBatch {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectorId     String
  connector       Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  source          String // bi, produtividade, metas, tarefas
  batchId         String
  generatedAt     DateTime
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  status          String // received, processed, error
  recordsReceived Int       @default(0)
  recordsInserted Int       @default(0)
  recordsUpdated  Int       @default(0)
  durationMs      Int?
  errorMessage    String?
  chunkCount      Int       @default(1)
  chunksReceived  Int       @default(1)
  syncMode        String    @default("full")

  @@unique([tenantId, connectorId, source, batchId])
  @@index([tenantId])
}

model ConnectorSourceStatus {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectorId     String
  connector       Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  source          String
  lastSyncAt      DateTime?
  lastSuccessAt   DateTime?
  lastErrorAt     DateTime?
  lastError       String?
  recordsLastSync Int       @default(0)
  status          String    @default("never_synced") // healthy, delayed, error, never_synced, disabled

  @@unique([tenantId, connectorId, source])
  @@index([tenantId])
}

model ConnectorSyncStaging {
  id          String    @id @default(cuid())
  tenantId    String
  connectorId String
  connector   Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  source      String
  batchId     String
  records     Json // Armazena payload em JSONB
  chunkIndex  Int       @default(0)
  chunkCount  Int       @default(1)
  syncMode    String    @default("full")
  createdAt   DateTime  @default(now())

  @@unique([tenantId, connectorId, source, batchId, chunkIndex])
  @@index([tenantId])
}

model ConnectorSyncRecord {
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectorId String
  connector   Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  source      String
  recordKey   String
  record      Json
  syncMode    String    @default("incremental")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@id([tenantId, connectorId, source, recordKey])
  @@index([tenantId, source])
}

// ── FIORIX PESSOAS MODULE ─────────────────────────────────────────────

model FiorixComunicado {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  titulo         String
  conteudo       String    @db.Text
  conteudoHash   String    @map("conteudo_hash")
  versao         Int       @default(1)
  prioridade     String    @default("NORMAL") // URGENTE, IMPORTANTE, NORMAL
  autorId        String    @map("autor_id")
  autor          User      @relation("ComunicadosCriados", fields: [autorId], references: [id])
  destinatarios  String[] // Array of roles, specific user IDs, or "TODOS"
  dataPublicacao DateTime  @default(now()) @map("data_publicacao")
  dataExpiracao  DateTime? @map("data_expiracao")
  exigeCiencia   Boolean   @default(true) @map("exige_ciencia")
  notificar      Boolean   @default(true)
  status         String    @default("PUBLICADO") // PUBLICADO, CANCELADO, RASCUNHO
  imutavel       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  anexos   FiorixComunicadoAnexo[]
  ciencias FiorixComunicadoCiencia[]

  @@index([tenantId])
  @@map("fiorix_comunicados")
}

model FiorixComunicadoAnexo {
  id           String           @id @default(cuid())
  tenantId     String           @map("tenant_id")
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comunicadoId String           @map("comunicado_id")
  comunicado   FiorixComunicado @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  storagePath  String           @map("storage_path")
  nomeOriginal String           @map("nome_original")
  mimeType     String           @map("mime_type")
  tamanhoBytes Int              @map("tamanho_bytes")
  hashSha256   String           @map("hash_sha256")
  uploadedBy   String           @map("uploaded_by")
  uploader     User             @relation(fields: [uploadedBy], references: [id])
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([comunicadoId])
  @@map("fiorix_comunicados_anexos")
}

model FiorixComunicadoCiencia {
  id               String           @id @default(cuid())
  tenantId         String           @map("tenant_id")
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comunicadoId     String           @map("comunicado_id")
  comunicado       FiorixComunicado @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
