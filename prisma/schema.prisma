// ── MENSAGENS CORPORATIVAS ───────────────────────────────────────────

enum ConversaTipo {
  DIRECT
  GROUP
}

enum MembroPapel {
  ADMIN
  MEMBER
}

model Conversa {
  id                   String       @id @default(cuid())
  tenantId             String       @map("tenant_id")
  tenant               Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo                 ConversaTipo @default(DIRECT)
  titulo               String?
  descricao            String?      @db.Text
  avatarUrl            String?      @map("avatar_url")
  criadoPor            String?      @map("criado_por")
  criador              User?        @relation("ConversasCriadas", fields: [criadoPor], references: [id], onDelete: SetNull)
  lastMessageAt        DateTime     @default(now()) @map("last_message_at")
  // Permissões do grupo
  permissaoEnvio       String       @default("ALL") @map("permissao_envio") // ALL | ADMIN_ONLY
  permissaoEdicaoDados String       @default("ALL") @map("permissao_edicao_dados") // ALL | ADMIN_ONLY
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  membros   ConversaMembro[]
  mensagens Mensagem[]

  @@index([tenantId])
  @@index([tenantId, lastMessageAt])
  @@map("fiorix_conversas")
}

model ConversaMembro {
  id         String      @id @default(cuid())
  tenantId   String      @map("tenant_id")
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversaId String      @map("conversa_id")
  conversa   Conversa    @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  usuarioId  String      @map("usuario_id")
  usuario    User        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  papel      MembroPapel @default(MEMBER)
  joinedAt   DateTime    @default(now()) @map("joined_at")
  lastReadAt DateTime    @default(now()) @map("last_read_at")
  muted      Boolean     @default(false)
  // V1 — preferências por membro
  pinnedAt   DateTime?   @map("pinned_at") // NULL = não fixada
  archivedAt DateTime?   @map("archived_at") // NULL = não arquivada
  draft      String?     @db.Text // Rascunho de texto não enviado
  mutedUntil DateTime?   @map("muted_until") // NULL = não silenciada; future = silenciada até

  @@unique([conversaId, usuarioId])
  @@index([tenantId])
  @@index([usuarioId])
  @@map("fiorix_conversa_membros")
}

model Mensagem {
  id               String     @id @default(cuid())
  tenantId         String     @map("tenant_id")
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversaId       String     @map("conversa_id")
  conversa         Conversa   @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  remetenteId      String     @map("remetente_id")
  remetente        User       @relation("MensagensEnviadas", fields: [remetenteId], references: [id], onDelete: Cascade)
  conteudo         String     @db.Text
  // tipo: TEXT (V1)
  tipo             String     @default("TEXT")
  // LEGADO NÃO UTILIZADO — V1 (colunas mantidas no banco para evitar ALTER TABLE desnecessário)
  cardTipo         String?    @map("card_tipo")
  cardReferenciaId String?    @map("card_referencia_id")
  cardMetadata     Json?      @map("card_metadata")
  respostaAId      String?    @map("resposta_a_id")
  respostaA        Mensagem?  @relation("MensagemRespostas", fields: [respostaAId], references: [id], onDelete: SetNull)
  respostas        Mensagem[] @relation("MensagemRespostas")
  forwardedFromId  String?    @map("forwarded_from_id")
  forwardedFrom    Mensagem?  @relation("MensagemEncaminhamentos", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  encaminhamentos  Mensagem[] @relation("MensagemEncaminhamentos")
  isDeleted        Boolean    @default(false) @map("is_deleted")
  deletedAt        DateTime?  @map("deleted_at")
  editedAt         DateTime?  @map("edited_at")
  createdAt        DateTime   @default(now()) @map("created_at")

  anexos  MensagemAnexo[]
  reacoes MensagemReacao[]

  @@index([tenantId])
  @@index([conversaId, createdAt])
  @@index([remetenteId])
  @@map("fiorix_mensagens")
}

model MensagemAnexo {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mensagemId   String   @map("mensagem_id")
  mensagem     Mensagem @relation(fields: [mensagemId], references: [id], onDelete: Cascade)
  nomeArquivo  String   @map("nome_arquivo")
  tamanhoBytes Int      @map("tamanho_bytes")
  mimeType     String   @map("mime_type")
  storagePath  String   @map("storage_path")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([mensagemId])
  @@map("fiorix_mensagem_anexos")
}

model MensagemReacao {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mensagemId String   @map("mensagem_id")
  mensagem   Mensagem @relation(fields: [mensagemId], references: [id], onDelete: Cascade)
  usuarioId  String   @map("usuario_id")
  usuario    User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  emoji      String
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([mensagemId, usuarioId, emoji])
  @@index([tenantId])
  @@index([mensagemId])
  @@map("fiorix_mensagem_reacoes")
}

model PushSubscription {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
