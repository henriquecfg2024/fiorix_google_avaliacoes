model MessagingPolicy {
  id                 String   @id @default(cuid())
  tenantId           String   @unique @map("tenant_id")
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  directEnabled      Boolean  @default(true) @map("direct_enabled")
  groupsEnabled      Boolean  @default(true) @map("groups_enabled")
  attachmentsEnabled Boolean  @default(true) @map("attachments_enabled")
  maxAttachmentBytes Int      @default(26214400) @map("max_attachment_bytes")
  allowedMimes       String[] @default(["image/jpeg", "image/png", "image/webp", "application/pdf", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"]) @map("allowed_mimes")
  retentionDays      Int      @default(365) @map("retention_days")
  allowDelete        Boolean  @default(true) @map("allow_delete")
  allowEdit          Boolean  @default(true) @map("allow_edit")
  editWindowMinutes  Int      @default(15) @map("edit_window_minutes")
