# SeleÃ§Ã£o de Ambiente: 'homolog' (default) ou 'production'
FIORIX_CONNECTOR_ENV="homolog"

# Destino da API FIORIX SaaS
FIORIX_API_URL="https://app.fiorix.com.br/api/v1/connector/sync"
CONNECTOR_ID=seu-connector-id
CONNECTOR_SECRET=seu-connector-secret

# ConexÃ£o SQL Server Local (WEBRI - Leitura)
SQL_SERVER_HOST="localhost"
SQL_SERVER_DATABASE="WEBRI"
SQL_SERVER_USER="fiorix_ro"
SQL_SERVER_PASSWORD="senha_segura"

# Agendamento e ParÃ¢metros
SYNC_INTERVAL_SECONDS="60"
SHADOW_MODE="true"
SCHEDULER_ENABLED="true"
AUTO_SYNC_ENABLED="false"
BI_AUTO_SYNC_ENABLED="true"
PRODUTIVIDADE_AUTO_SYNC_ENABLED="true"
TAREFAS_AUTO_SYNC_ENABLED="true"
METAS_RECONCILIATION_ENABLED="true"

# Lote e Janelas
CHUNK_SIZE_RECORDS="500"
INCREMENTAL_OVERLAP_MINUTES="5"
RECONCILIATION_LOOKBACK_DAYS="7"

# Proxy de Rede (se necessÃ¡rio na Serventia)
PROXY_ENABLED="false"
PROXY_HOST=""
PROXY_PORT="3128"
PROXY_USERNAME=""
PROXY_PASSWORD=""
NO_PROXY="localhost,127.0.0.1"
