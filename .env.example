# ────────────────────────────────────────────────────────────────────────
# FIORIX — Variáveis de Ambiente (Exemplo)
#
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA versione o arquivo .env com credenciais reais.
# ────────────────────────────────────────────────────────────────────────

# ── Banco de Dados ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://usuario:senha@host:5432/database"
DIRECT_URL="postgresql://usuario:senha@host:5432/database"

# ── Autenticação ────────────────────────────────────────────────────────
AUTH_SECRET="gere_com_openssl_rand_base64_32"

# ── Supabase ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sua_chave_publica_aqui"
SUPABASE_SERVICE_ROLE_KEY="sua_service_role_key_aqui"

# ── Google OAuth ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="seu_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu_client_secret"
GOOGLE_TOKEN_ENCRYPTION_KEY="gere_com_node_e_console_log_require_crypto_randomBytes_32_toString_hex"

# ── Criptografia de Integrações (AES-256-GCM) ──────────────────────────
# Obrigatória para salvar credenciais de integrações externas (NextQS, etc.)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DEVE ter exatamente 64 caracteres hexadecimais (32 bytes)
FIORIX_INTEGRATION_ENCRYPTION_KEY="insira_uma_chave_hex_de_64_caracteres_aqui"

# ── Web Push (VAPID) ───────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY="sua_chave_publica_vapid"
VAPID_PRIVATE_KEY="sua_chave_privada_vapid"
