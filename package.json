{
  "name": "fiorix-connector",
  "version": "0.1.0",
  "description": "FIORIX Connector Local Agent",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:homolog": "tsx src/index.ts",
    "dev:production": "node --env-file=.env.production node_modules/tsx/dist/cli.mjs src/index.ts",
    "build": "tsup src/index.ts --format esm --clean",
    "start": "node dist/index.js",
    "start:homolog": "node dist/index.js",
    "start:production": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "dotenv": "^16.4.5",
    "mammoth": "^1.13.0",
    "mssql": "^10.0.2",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.12.7",
    "@types/uuid": "^9.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8.0.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
